{
  "name": "agent-audio",
  "version": "0.2.0",
  "description": "Zero-dependency headless audio renderer and deterministic listening gate for coding agents.",
  "keywords": ["audio", "sfx", "synth", "loudness", "bs1770", "true-peak", "wav", "agents"],
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-audio": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "recipes",
    "SKILL.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && node --test dist-test/tests/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
